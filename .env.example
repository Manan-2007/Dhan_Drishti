# Dhan Drishti — server configuration (copy to .env; all optional with sane local defaults)
PORT=4000
HOST=127.0.0.1

# libsql/SQLite location. Relative paths resolve from the server package cwd.
DATABASE_URL=./data/dhan-drishti.sqlite

# Set true only when serving over HTTPS (enables Secure cookies).
SECURE_COOKIES=false
SESSION_TTL_DAYS=30

NODE_ENV=development
