    "pdfjs-dist": "^6.3.289",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "drizzle-kit": "^0.30.1",
